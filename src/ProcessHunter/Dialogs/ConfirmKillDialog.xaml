<Window x:Class="ProcessHunter.Dialogs.ConfirmKillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar Encerramento" Width="460" Height="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="None" AllowsTransparency="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSoftBrush}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" FontSize="18" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Finalizar Processo?" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="TxtSub" Text="Esta ação pode causar perda de dados não salvos." Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource BgBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtProcName" Text="Processo: chrome.exe" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="TxtPid" Text="PID: 1234 · Processo Filho: Não" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" FontSize="12"/>
                    <TextBlock x:Name="TxtWarning" Text="Processos do sistema não podem ser finalizados." Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" FontSize="11" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancelar" Margin="0,0,10,0" Width="100" Height="34" Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm" Content="Finalizar Processo" Style="{StaticResource DangerButton}" Width="150" Height="34" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
