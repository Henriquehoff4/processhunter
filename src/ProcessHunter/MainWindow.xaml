<Window x:Class="ProcessHunter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ProcessHunter.Controls"
        Title="ProcessHunter — Ultimate System Monitor" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="SensorItemTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="64"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER BAR ==================== -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ProcessHunter" Style="{StaticResource H2}" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                            <Border Background="{StaticResource SandBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Monitoramento em Tempo Real &amp; Diagnóstico" Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Quick Metrics Ticker -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- CPU Ticker -->
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CpuBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HdrCpu" Text="0.0%" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- RAM Ticker -->
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM" FontWeight="Bold" FontSize="11" Foreground="{StaticResource RamBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HdrRam" Text="0.0%" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- GPU Ticker -->
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU" FontWeight="Bold" FontSize="11" Foreground="{StaticResource GpuBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HdrGpu" Text="0%" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- VRAM Ticker -->
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VRAM" FontWeight="Bold" FontSize="11" Foreground="{StaticResource VramBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HdrVram" Text="0%" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Disk Ticker -->
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="14" Padding="12,5" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DISCO" FontWeight="Bold" FontSize="11" Foreground="{StaticResource DiskBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HdrDisk" Text="0 MB/s" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <!-- Net Ticker -->
                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="14" Padding="12,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="REDE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource NetBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HdrNet" Text="0 MB/s" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Overlay Toggle Button -->
                    <Button x:Name="BtnToggleOverlay" Style="{StaticResource GhostButton}" ToolTip="Exibir HUD Overlay Compacto" Margin="0,0,4,0" Click="BtnToggleOverlay_Click">
                        <TextBlock Text="&#xE737;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                    <!-- Light Mode Toggle -->
                    <ToggleButton x:Name="BtnLightMode" Style="{StaticResource Chip}" ToolTip="Modo Leve (economiza CPU do monitor durante jogos/renders)" Margin="0,0,8,0" Click="BtnLightMode_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Modo Leve"/>
                        </StackPanel>
                    </ToggleButton>
                    <!-- Interval Selector -->
                    <ComboBox x:Name="CmbInterval" Width="100" Margin="0,0,8,0" SelectionChanged="CmbInterval_SelectionChanged">
                        <ComboBoxItem Content="500 ms" Tag="500"/>
                        <ComboBoxItem Content="1.0 s" Tag="1000"/>
                        <ComboBoxItem Content="2.0 s" Tag="2000"/>
                        <ComboBoxItem Content="5.0 s" Tag="5000"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Nav -->
                <ColumnDefinition Width="240"/>
                <!-- Tab Pages Container -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,20">
                <DockPanel>
                    <!-- Nav Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked" Tag="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Visão Geral" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavProcesses" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Processos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavGpu" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="GPU RTX 4060" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSensors" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Sensores" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavBottlenecks" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="Gargalos &amp; Saúde" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="BadgeFindings" Grid.Column="1" Background="{StaticResource WarnBrush}" CornerRadius="8" Padding="6,1" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtFindingsCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Gráficos &amp; Histórico" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavServices" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Serviços &amp; Início" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Configurações" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Footer Info -->
                    <Border DockPanel.Dock="Bottom" Margin="14,12" Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Overhead do monitor" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="TxtSelfOverhead" Text="CPU: 0.1% · RAM: 28 MB" Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtEngineStatus" Text="NtQuerySys + NVML OK" FontSize="10" Foreground="{StaticResource OkBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ==================== TAB 0: VISÃO GERAL ==================== -->
            <ScrollViewer x:Name="TabOverview" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
                <StackPanel>
                    <!-- Cards Grid (CPU, RAM, GPU, DISK, NET) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card CPU -->
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource CpuTileBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{StaticResource CpuBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Processador (CPU)" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="TxtCpuModel" Text="CPU" Style="{StaticResource Caption}" MaxWidth="220"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="TxtCpuPct" Text="0.0%" Style="{StaticResource Metric}" Foreground="{StaticResource CpuBrush}"/>
                                    <TextBlock x:Name="TxtCpuFreq" Text="— GHz" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <ctrl:Sparkline x:Name="SpkCpu" Grid.Row="2" Stroke="{StaticResource CpuBrush}" MaxValue="100" ShowGridLines="True" ShowCurrentValue="True" Unit="%"/>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtCpuCoresInfo" Text="— Cores · — Threads" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtCpuTemp" Text="Temp: — °C" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Card RAM -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource RamTileBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource RamBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Memória RAM" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="TxtRamTotal" Text="Total: — GB" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="TxtRamPct" Text="0.0%" Style="{StaticResource Metric}" Foreground="{StaticResource RamBrush}"/>
                                    <TextBlock x:Name="TxtRamAvail" Text="Livre: — GB" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <ctrl:Sparkline x:Name="SpkRam" Grid.Row="2" Stroke="{StaticResource RamBrush}" MaxValue="100" ShowGridLines="True" ShowCurrentValue="True" Unit="%"/>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtCommit" Text="Comprometida: —" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtCache" Text="Cache: —" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Card GPU -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource GpuTileBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource GpuBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Placa de vídeo (GPU)" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="TxtGpuName" Text="NVIDIA GeForce RTX 4060" Style="{StaticResource Caption}" MaxWidth="220"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="TxtGpuPct" Text="0%" Style="{StaticResource Metric}" Foreground="{StaticResource GpuBrush}"/>
                                    <TextBlock x:Name="TxtGpuPower" Text="— W" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                    <TextBlock x:Name="TxtGpuTempOverview" Text="— °C" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,6" Foreground="{StaticResource TempBrush}"/>
                                </StackPanel>
                                <ctrl:Sparkline x:Name="SpkGpu" Grid.Row="2" Stroke="{StaticResource GpuBrush}" MaxValue="100" ShowGridLines="True" ShowCurrentValue="True" Unit="%"/>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtVramOverview" Text="VRAM: —" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtGpuClocks" Text="Clock: — MHz" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Multi-Core Processor Visualization Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource CpuBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Núcleos individuais da CPU" Style="{StaticResource Overline}"/>
                                </StackPanel>
                                <TextBlock Text="Utilização por Thread Lógico em Tempo Real" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ctrl:MultiCoreView x:Name="CoreView" Height="64"/>
                        </StackPanel>
                    </Border>

                    <!-- Secondary Cards: Storage & Network -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Storage / Disks Card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource DiskTileBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" Foreground="{StaticResource DiskBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Armazenamento / disco" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="TxtDiskStats" Text="Leitura &amp; Escrita" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="TxtDiskSpeed" Text="0.0 MB/s" Style="{StaticResource Metric}" Foreground="{StaticResource DiskBrush}"/>
                                    <TextBlock x:Name="TxtDiskActive" Text="Ativo: 0%" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <ctrl:Sparkline x:Name="SpkDisk" Grid.Row="2" Stroke="{StaticResource DiskBrush}" AutoScale="True" ShowGridLines="True" ShowCurrentValue="True" Unit="MB/s"/>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtDiskRW" Text="R: 0.0 MB/s · W: 0.0 MB/s" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtDiskLat" Text="Latência: — ms" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Network Card -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource NetTileBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE839;" Style="{StaticResource Icon}" Foreground="{StaticResource NetBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rede &amp; internet" Style="{StaticResource Overline}"/>
                                        <TextBlock x:Name="TxtNetBandwidth" Text="Download &amp; Upload" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                                    <TextBlock x:Name="TxtNetSpeed" Text="0.0 MB/s" Style="{StaticResource Metric}" Foreground="{StaticResource NetBrush}"/>
                                    <TextBlock x:Name="TxtNetDownUp" Text="Down: 0 MB/s · Up: 0 MB/s" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <ctrl:Sparkline x:Name="SpkNet" Grid.Row="2" Stroke="{StaticResource NetBrush}" AutoScale="True" ShowGridLines="True" ShowCurrentValue="True" Unit="MB/s"/>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtNetAdapters" Text="Interfaces Físicas Ativas" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtNetCapacity" Text="Capacidade: —" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Top Consumers Summary Strip -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Maior consumidor de CPU" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="TxtTopCpu" Text="—" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Maior consumidor de RAM" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="TxtTopRam" Text="—" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0">
                                <TextBlock Text="Maior consumidor de GPU" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="TxtTopGpu" Text="—" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Maior consumidor de disco" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="TxtTopDisk" Text="—" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 1: GERENCIADOR DE PROCESSOS ==================== -->
            <Grid x:Name="TabProcesses" Grid.Column="1" Visibility="Collapsed" Margin="28,24">
                <Grid.RowDefinitions>
                    <!-- Controls and Filters Toolbar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Process DataGrid -->
                    <RowDefinition Height="*"/>
                    <!-- Details preview footer of selected process -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Width="230">
                        <TextBox x:Name="TxtSearchProc" Padding="32,0,10,0" TextChanged="TxtSearchProc_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="Pesquisar processo, PID, usuário..." Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearchProc}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Filter Chips -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <RadioButton x:Name="FilterAll" Content="Todos" Style="{StaticResource ChipRadio}" IsChecked="True" Click="FilterChip_Click"/>
                        <RadioButton x:Name="FilterApps" Content="Aplicativos" Style="{StaticResource ChipRadio}" Click="FilterChip_Click"/>
                        <RadioButton x:Name="FilterBg" Content="Segundo Plano" Style="{StaticResource ChipRadio}" Click="FilterChip_Click"/>
                        <RadioButton x:Name="FilterGpu" Content="Usa GPU" Style="{StaticResource ChipRadio}" Click="FilterChip_Click"/>
                        <RadioButton x:Name="FilterHighCpu" Content="Alto Consumo" Style="{StaticResource ChipRadio}" Click="FilterChip_Click"/>
                        <RadioButton x:Name="FilterWindows" Content="Windows" Style="{StaticResource ChipRadio}" Click="FilterChip_Click"/>
                    </WrapPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tree View / Flat List Toggle -->
                        <ToggleButton x:Name="BtnTreeMode" Style="{StaticResource Chip}" Content="🌳 Modo Árvore" Margin="0,0,8,0" Click="BtnTreeMode_Click"/>

                        <!-- End Task Button -->
                        <Button x:Name="BtnEndTask" Style="{StaticResource DangerButton}" Content="Finalizar Processo" Margin="0,0,8,0" Click="BtnEndTask_Click"/>

                        <!-- Export CSV Button -->
                        <Button x:Name="BtnExportProcs" Style="{StaticResource GhostButton}" ToolTip="Exportar Tabela de Processos para CSV" Click="BtnExportProcs_Click">
                            <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource MutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Process DataGrid -->
                <DataGrid x:Name="GridProcesses" Grid.Row="1" SelectionChanged="GridProcesses_SelectionChanged" MouseDoubleClick="GridProcesses_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Finalizar Processo" Click="CtxKill_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" FontSize="13"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Finalizar Árvore de Processos" Click="CtxKillTree_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" FontSize="13"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Definir Prioridade">
                                <MenuItem.Icon><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                <MenuItem Header="Alta" Click="CtxPriority_Click" Tag="High"/>
                                <MenuItem Header="Acima do Normal" Click="CtxPriority_Click" Tag="AboveNormal"/>
                                <MenuItem Header="Normal" Click="CtxPriority_Click" Tag="Normal"/>
                                <MenuItem Header="Abaixo do Normal" Click="CtxPriority_Click" Tag="BelowNormal"/>
                                <MenuItem Header="Baixa" Click="CtxPriority_Click" Tag="Idle"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Abrir Local do Arquivo" Click="CtxOpenLocation_Click">
                                <MenuItem.Icon><TextBlock Text="&#xED25;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Propriedades do Windows" Click="CtxProperties_Click">
                                <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Copiar Nome do Processo" Click="CtxCopyName_Click"/>
                            <MenuItem Header="Copiar PID" Click="CtxCopyPid_Click"/>
                            <MenuItem Header="Copiar Caminho Completo" Click="CtxCopyPath_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Name with Icon & Tree Indent -->
                        <DataGridTemplateColumn Header="Nome do Processo" Width="260" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding IndentPadding}">
                                        <TextBlock Text="{Binding ExpanderGlyph}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" Foreground="{StaticResource MutedBrush}"/>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="CRÍTICO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PID -->
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource Mono}"/>

                        <!-- CPU % -->
                        <DataGridTemplateColumn Header="CPU" Width="85" SortMemberPath="Cpu">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CpuText}" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- RAM Privada -->
                        <DataGridTextColumn Header="RAM Privada" Binding="{Binding RamText}" Width="110" ElementStyle="{StaticResource Mono}"/>

                        <!-- RAM Working Set -->
                        <DataGridTextColumn Header="Conjunto Trab." Binding="{Binding WorkingSetText}" Width="110" ElementStyle="{StaticResource Mono}"/>

                        <!-- GPU % -->
                        <DataGridTemplateColumn Header="GPU" Width="80" SortMemberPath="Gpu">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GpuText}" FontWeight="SemiBold" Foreground="{StaticResource GpuBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Motores GPU -->
                        <DataGridTextColumn Header="Motores GPU" Binding="{Binding GpuEngines}" Width="140" ElementStyle="{StaticResource Caption}"/>

                        <!-- VRAM Dedicada -->
                        <DataGridTextColumn Header="VRAM" Binding="{Binding VramText}" Width="95" ElementStyle="{StaticResource Mono}"/>

                        <!-- Disco E/S -->
                        <DataGridTextColumn Header="E/S Disco" Binding="{Binding DiskText}" Width="100" ElementStyle="{StaticResource Mono}"/>

                        <!-- Threads -->
                        <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="75" ElementStyle="{StaticResource Mono}"/>

                        <!-- Prioridade -->
                        <DataGridTextColumn Header="Prioridade" Binding="{Binding Priority}" Width="95"/>

                        <!-- Usuário -->
                        <DataGridTextColumn Header="Usuário" Binding="{Binding UserText}" Width="130" ElementStyle="{StaticResource Caption}"/>

                        <!-- Fornecedor -->
                        <DataGridTextColumn Header="Fornecedor / Autor" Binding="{Binding VendorText}" Width="160" ElementStyle="{StaticResource Caption}"/>

                        <!-- Assinatura Digital -->
                        <DataGridTemplateColumn Header="Assinatura" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SignatureText}" Foreground="{Binding SignatureColor}" FontSize="11.5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Caminho Completo -->
                        <DataGridTextColumn Header="Caminho do Executável" Binding="{Binding PathText}" Width="250" ElementStyle="{StaticResource Caption}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Process Details Footer -->
                <Border x:Name="PanelProcDetails" Grid.Row="2" Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="ImgSelIcon" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtSelTitle" Text="process.exe (PID 0000)" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="TxtSelRuntime" Text="Em execução há —" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtSelPath" Text="C:\Path\To\Process.exe" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtSelSigNote" Text="Assinatura digital verificada" FontSize="11" Foreground="{StaticResource OkBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Abrir Pasta" Margin="0,0,8,0" Click="BtnSelOpenFolder_Click"/>
                            <Button Content="Propriedades" Margin="0,0,8,0" Click="BtnSelProperties_Click"/>
                            <Button Content="Finalizar" Style="{StaticResource DangerButton}" Click="BtnSelKill_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== TAB 2: GPU RTX 4060 DEDICADA ==================== -->
            <ScrollViewer x:Name="TabGpu" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
                <StackPanel>
                    <!-- GPU Banner -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource GpuTileBrush}" BorderBrush="{StaticResource GpuBrush}" BorderThickness="1" Margin="0,0,16,0">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource GpuBrush}" FontSize="24" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GpuTabName" Text="NVIDIA GeForce RTX 4060" Style="{StaticResource H1}" FontSize="20"/>
                                    <Border Background="{StaticResource OkSoftBrush}" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="GpuTabDriver" Text="Driver: 610.88" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GpuBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="GpuTabStatus" Text="Monitoramento via NVML Nativo + Contadores Direct3D/DxgKrnl" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="GpuTabPState" Text="Estado: P0 (Máx)" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="GpuTabThrottle" Text="Throttling: Nenhum" FontSize="11" Foreground="{StaticResource OkBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metrics Grid (Clocks, Power, Fan, Temp) -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Util Card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Carga da GPU" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="GpuDetailPct" Text="0%" Style="{StaticResource Metric}" Foreground="{StaticResource GpuBrush}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="GpuMemCtrlPct" Text="Contr. Memória: 0%" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- VRAM Card -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="VRAM utilizada" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="GpuDetailVram" Text="0 MB / 8 GB" Style="{StaticResource Metric}" Foreground="{StaticResource VramBrush}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="GpuDetailVramShared" Text="Compartilhada: 0 MB" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Clocks Card -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="Frequência dos clocks" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="GpuDetailCoreClock" Text="— MHz" Style="{StaticResource Metric}" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="GpuDetailMemClock" Text="Memória: — MHz" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Thermals & Power Card -->
                        <Border Grid.Column="3" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Temperatura &amp; energia" Style="{StaticResource Overline}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="GpuDetailTemp" Text="— °C" Style="{StaticResource Metric}" Foreground="{StaticResource TempBrush}"/>
                                    <TextBlock x:Name="GpuDetailPower" Text="— W" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <TextBlock x:Name="GpuDetailFan" Text="Ventoinha: — %" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VRAM Capacity Bar -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Capacidade da VRAM (GDDR6 dedicada)" Style="{StaticResource Overline}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="GpuVramBarText" Text="0 MB / 8188 MB (0%)" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="PbVram" Height="8" Maximum="100" Value="0" Foreground="{StaticResource VramBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU Engines Breakdown -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Utilização dos motores gráficos (engines)" Style="{StaticResource Overline}" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ListGpuEngines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Engine}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Util, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource GpuBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UtilText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Top Processes Using GPU -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Processos em execução na GPU" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="GridGpuProcesses" Height="220" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75" ElementStyle="{StaticResource Mono}"/>
                                    <DataGridTextColumn Header="GPU %" Binding="{Binding GpuText}" Width="90" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Motores" Binding="{Binding GpuEngines}" Width="160"/>
                                    <DataGridTextColumn Header="VRAM Dedicada" Binding="{Binding VramText}" Width="120" ElementStyle="{StaticResource Mono}"/>
                                    <DataGridTextColumn Header="Caminho" Binding="{Binding PathText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 3: SENSORES PROFUNDOS (HWiNFO-grade) ==================== -->
            <ScrollViewer x:Name="TabSensors" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
                <StackPanel>
                    <!-- Banner de elevação / indisponibilidade -->
                    <Border x:Name="SensorBanner" Style="{StaticResource Card}" Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sensores ring-0 indisponíveis" Style="{StaticResource Overline}" Foreground="{StaticResource WarnBrush}"/>
                                <TextBlock x:Name="SensorBannerText" Text="" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnElevate" Grid.Column="1" Content="Reiniciar como Administrador" Margin="16,0,0,0" VerticalAlignment="Center" Click="BtnElevate_Click"/>
                        </Grid>
                    </Border>

                    <!-- CPU: temperatura, potência e tensão -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,13.33,0">
                            <StackPanel>
                                <TextBlock Text="Temperatura da CPU" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SensorCpuTemp" Text="— °C" Style="{StaticResource Metric}" Foreground="{StaticResource TempBrush}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SensorCpuTempSub" Text="—" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="SensorCoreTempMax" Text="Núcleo máx.: —" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6.67,0,6.67,0">
                            <StackPanel>
                                <TextBlock Text="Potência do package (RAPL)" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SensorCpuPower" Text="— W" Style="{StaticResource Metric}" Foreground="{StaticResource CpuBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="Consumo medido nos MSRs de energia da CPU." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="13.33,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Tensão do núcleo" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SensorCoreVoltage" Text="— V" Style="{StaticResource Metric}" Foreground="{StaticResource RamBrush}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SensorCoreVoltageSub" Text="—" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Temperatura por núcleo -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Temperatura por núcleo" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ListCoreTemps">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TempBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyCoreTemps" Text="Nenhuma leitura disponível." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Ventoinhas, tensões e temperaturas da placa -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,13.33,0">
                            <StackPanel>
                                <TextBlock Text="Ventoinhas (RPM)" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ListFans" ItemTemplate="{StaticResource SensorItemTemplate}"/>
                                <TextBlock x:Name="EmptyFans" Text="Nenhuma leitura disponível." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6.67,0,6.67,0">
                            <StackPanel>
                                <TextBlock Text="Tensões (V)" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ListVoltages" ItemTemplate="{StaticResource SensorItemTemplate}"/>
                                <TextBlock x:Name="EmptyVoltages" Text="Nenhuma leitura disponível." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="13.33,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Temperaturas da placa (°C)" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ListBoardTemps" ItemTemplate="{StaticResource SensorItemTemplate}"/>
                                <TextBlock x:Name="EmptyBoardTemps" Text="Nenhuma leitura disponível." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Memória e armazenamento -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Memória (DIMM)" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SensorDimmTemp" Text="— °C" Style="{StaticResource Metric}" Foreground="{StaticResource TempBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="Temperatura máxima entre os módulos de memória." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Armazenamento (NVMe/SSD/HDD)" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ListStorageTemps" ItemTemplate="{StaticResource SensorItemTemplate}"/>
                                <TextBlock x:Name="EmptyStorageTemps" Text="Nenhuma leitura disponível." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status do motor -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Motor de sensores" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="SensorStatus" Text="Inicializando..." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 4: DETECTOR DE GARGALOS ==================== -->
            <ScrollViewer x:Name="TabBottlenecks" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
                <StackPanel>
                    <!-- Status Overview Banner -->
                    <Border x:Name="BannerHealth" Style="{StaticResource Card}" Background="{StaticResource OkSoftBrush}" BorderBrush="{StaticResource OkTileBrush}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource OkTileBrush}" Margin="0,0,16,0">
                                <TextBlock x:Name="IconHealth" Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource OkBrush}" FontSize="20" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHealthTitle" Text="Sistema Saudável — Nenhum Gargalo Crítico" Style="{StaticResource H2}" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="TxtHealthSub" Text="O detector analisa CPU, RAM, VRAM, vazamentos progressivos, discos, temperaturas e saturação." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Exportar Diagnóstico (JSON)" Click="BtnExportFindings_Click"/>
                        </Grid>
                    </Border>

                    <!-- Active Findings List -->
                    <TextBlock Text="Alertas &amp; diagnósticos em tempo real" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="ListFindings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Category + Title + Severity -->
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,10,0" Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Explanation -->
                                        <TextBlock Grid.Row="1" Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{StaticResource TextBrush}" FontSize="12.5" LineHeight="18"/>

                                        <!-- Evidence Points -->
                                        <Border Grid.Row="2" Background="{StaticResource BgBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Evidências coletadas:" Style="{StaticResource Overline}" FontSize="10" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Evidence}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="• " Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Suggestions -->
                                        <StackPanel Grid.Row="3">
                                            <TextBlock Text="Sugestões de ação:" Style="{StaticResource Overline}" FontSize="10" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <TextBlock Text="✓ " Foreground="{StaticResource OkBrush}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 4: GRÁFICOS & HISTÓRICO ==================== -->
            <ScrollViewer x:Name="TabHistory" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
                <StackPanel>
                    <!-- Toolbar / Compare / Export -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Histórico local &amp; detecção de picos" Style="{StaticResource Overline}"/>
                                <TextBlock Text="Identifique o processo exato responsável por qualquer pico de CPU, RAM, GPU ou Disco." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Exportar CSV" Margin="0,0,8,0" Click="BtnExportHistCsv_Click"/>
                                <Button Content="Exportar JSON" Margin="0,0,8,0" Click="BtnExportHistJson_Click"/>
                                <Button Content="Limpar Histórico" Style="{StaticResource DangerButton}" Click="BtnClearHist_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Real-Time Timeline Graphs (Full Width) -->
                    <!-- CPU Timeline -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Utilização total da CPU (%)" Style="{StaticResource Overline}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HistPeakCpu" Text="Pico Recente: —" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ctrl:Sparkline x:Name="HistSpkCpu" Height="100" Stroke="{StaticResource CpuBrush}" MaxValue="100" ShowGridLines="True" ShowCurrentValue="True" Unit="%"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Timeline -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Utilização da memória RAM (%)" Style="{StaticResource Overline}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HistPeakRam" Text="Pico Recente: —" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ctrl:Sparkline x:Name="HistSpkRam" Height="100" Stroke="{StaticResource RamBrush}" MaxValue="100" ShowGridLines="True" ShowCurrentValue="True" Unit="%"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU & VRAM Timeline -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="GPU &amp; VRAM dedicada (%)" Style="{StaticResource Overline}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HistPeakGpu" Text="Pico Recente: —" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ctrl:Sparkline x:Name="HistSpkGpu" Height="100" Stroke="{StaticResource GpuBrush}" MaxValue="100" ShowGridLines="True" ShowCurrentValue="True" Unit="%"/>
                        </StackPanel>
                    </Border>

                    <!-- Disk Timeline -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Atividade de E/S do disco (MB/s)" Style="{StaticResource Overline}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HistPeakDisk" Text="Pico Recente: —" Style="{StaticResource Caption}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ctrl:Sparkline x:Name="HistSpkDisk" Height="100" Stroke="{StaticResource DiskBrush}" AutoScale="True" ShowGridLines="True" ShowCurrentValue="True" Unit="MB/s"/>
                        </StackPanel>
                    </Border>

                    <!-- Before / After Snapshot Comparison Card -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Comparador de impacto: antes e depois de abrir um app" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBlock Text="Capture o estado antes de abrir um jogo, After Effects ou modelo de IA e depois meça o consumo adicional exato." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button x:Name="BtnCaptureA" Content="1. Capturar Ponto A (Antes)" Margin="0,0,10,0" Click="BtnCaptureA_Click"/>
                                <Button x:Name="BtnCaptureB" Content="2. Capturar Ponto B (Depois &amp; Comparar)" IsEnabled="False" Margin="0,0,10,0" Click="BtnCaptureB_Click"/>
                                <TextBlock x:Name="TxtSnapshotStatus" Text="Nenhum ponto de comparação capturado." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid x:Name="GridSnapshotDiff" Height="200" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Δ CPU" Binding="{Binding DCpuText}" Width="100" ElementStyle="{StaticResource Mono}"/>
                                    <DataGridTextColumn Header="Δ RAM" Binding="{Binding DMemText}" Width="120" ElementStyle="{StaticResource Mono}"/>
                                    <DataGridTextColumn Header="Δ VRAM" Binding="{Binding DVramText}" Width="120" ElementStyle="{StaticResource Mono}"/>
                                    <DataGridTextColumn Header="Δ GPU" Binding="{Binding DGpuText}" Width="100" ElementStyle="{StaticResource Mono}"/>
                                    <DataGridTextColumn Header="Novo?" Binding="{Binding NewText}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 5: SERVIÇOS & INICIALIZAÇÃO ==================== -->
            <Grid x:Name="TabServices" Grid.Column="1" Visibility="Collapsed" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RadioServices" Content="Serviços do Windows" Style="{StaticResource ChipRadio}" IsChecked="True" Click="RadioServicesSubTab_Click"/>
                    <RadioButton x:Name="RadioStartup" Content="Programas na Inicialização" Style="{StaticResource ChipRadio}" Click="RadioServicesSubTab_Click"/>
                    <Button Content="Atualizar Lista" Margin="12,0,0,0" Click="BtnRefreshServices_Click"/>
                </StackPanel>

                <!-- Services DataGrid -->
                <DataGrid x:Name="GridServices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome do Serviço" Binding="{Binding Name}" Width="180" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Nome de Exibição" Binding="{Binding Display}" Width="280"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="110"/>
                        <DataGridTextColumn Header="Tipo de Inicialização" Binding="{Binding StartType}" Width="160"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" ElementStyle="{StaticResource Mono}"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="120" ElementStyle="{StaticResource Caption}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Startup DataGrid -->
                <DataGrid x:Name="GridStartup" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome do Item" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Comando / Caminho" Binding="{Binding Command}" Width="350" ElementStyle="{StaticResource Caption}"/>
                        <DataGridTextColumn Header="Local no Registro / Pasta" Binding="{Binding Location}" Width="220" ElementStyle="{StaticResource Caption}"/>
                        <DataGridTextColumn Header="Escopo" Binding="{Binding Scope}" Width="110"/>
                        <DataGridTextColumn Header="Habilitado" Binding="{Binding EnabledText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ==================== TAB 6: CONFIGURAÇÕES ==================== -->
            <ScrollViewer x:Name="TabSettings" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                    <!-- General Settings -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Desempenho &amp; taxa de atualização" Style="{StaticResource Overline}" Margin="0,0,0,12"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Intervalo de Coleta" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tempo entre amostras do sistema e processos." Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ComboBox x:Name="CfgInterval" Grid.Column="1" SelectionChanged="CfgInterval_SelectionChanged">
                                    <ComboBoxItem Content="500 ms" Tag="500"/>
                                    <ComboBoxItem Content="1.0 s (Padrão)" Tag="1000"/>
                                    <ComboBoxItem Content="2.0 s" Tag="2000"/>
                                    <ComboBoxItem Content="5.0 s (Econômico)" Tag="5000"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="CfgAutoLight" Content="Modo Leve Automático em Jogos / Aplicativos em Tela Cheia" Margin="0,10,0,4" Checked="Cfg_Changed" Unchecked="Cfg_Changed"/>
                            <TextBlock Text="Reduz consultas quando um jogo ou aplicativo 3D em tela cheia estiver em primeiro plano, eliminando qualquer impacto no FPS." Style="{StaticResource Caption}" Margin="42,0,0,10"/>

                            <CheckBox x:Name="CfgMinimizeTray" Content="Minimizar para a Bandeja do Windows (System Tray) ao Fechar" Margin="0,6,0,4" Checked="Cfg_Changed" Unchecked="Cfg_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Sensores Profundos -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Sensores profundos (estilo HWiNFO)" Style="{StaticResource Overline}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="CfgDeepSensors" Content="Ativar motor de sensores profundos (LibreHardwareMonitorLib)" Margin="0,6,0,4" Checked="CfgDeepSensors_Changed" Unchecked="CfgDeepSensors_Changed"/>
                            <TextBlock Text="Lê temperatura por núcleo, potência RAPL, tensões, RPM de ventoinhas e sensores da placa-mãe. Requer execução como administrador e o driver PawnIO instalado (licença MPL-2.0)." Style="{StaticResource Caption}" Margin="42,0,0,4" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Overlay & Notifications -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="HUD overlay &amp; notificações" Style="{StaticResource Overline}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="CfgOverlay" Content="Ativar HUD Overlay Compacto no Desktop" Margin="0,6,0,4" Checked="CfgOverlay_Changed" Unchecked="CfgOverlay_Changed"/>
                            <TextBlock Text="Painel flutuante compacto que pode ser arrastado para qualquer monitor." Style="{StaticResource Caption}" Margin="42,0,0,10"/>

                            <CheckBox x:Name="CfgNotifications" Content="Ativar Notificações de Alerta (Saturação de VRAM, RAM e Temperaturas)" Margin="0,6,0,4" Checked="Cfg_Changed" Unchecked="Cfg_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Watched Processes -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Monitorar processos específicos" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBlock Text="Receba avisos instantâneos quando processos específicos iniciarem ou encerrarem (ex: afterfx.exe, ollama.exe, blender.exe)." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAddWatch" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Adicionar" Click="BtnAddWatch_Click"/>
                            </Grid>
                            <ListBox x:Name="ListWatched" Height="100" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                            <Button Content="Remover Selecionado" HorizontalAlignment="Right" Margin="0,6,0,0" Click="BtnRemoveWatch_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Data Retention & History -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Retenção de dados &amp; histórico local" Style="{StaticResource Overline}" Margin="0,0,0,12"/>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Período de Retenção" FontWeight="SemiBold"/>
                                    <TextBlock Text="Dias de histórico salvos em formato JSON Lines compacto." Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ComboBox x:Name="CfgRetention" Grid.Column="1" SelectionChanged="CfgRetention_SelectionChanged">
                                    <ComboBoxItem Content="3 dias" Tag="3"/>
                                    <ComboBoxItem Content="7 dias (Padrão)" Tag="7"/>
                                    <ComboBoxItem Content="14 dias" Tag="14"/>
                                    <ComboBoxItem Content="30 dias" Tag="30"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="TxtStorageSize" Text="Espaço em disco utilizado: — KB" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusUptime" Text="Tempo de Atividade: —" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="StatusProcs" Text="Processos: 0" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="StatusThreads" Text="Threads: 0" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="StatusHandles" Text="Handles: 0" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTickTime" Text="Tempo de coleta: 1.2 ms" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                    <TextBlock Text="ProcessHunter v1.0.0 · 64-bit" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
