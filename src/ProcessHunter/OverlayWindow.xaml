<Window x:Class="ProcessHunter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcessHunter HUD" Width="440" Height="54"
        WindowStyle="None" AllowsTransparency="True" Topmost="True" ShowInTaskbar="False"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Border x:Name="HudBorder" Background="#F01E1915" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,7"
            MouseDown="Border_MouseDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource RaisedBrush}" Margin="0,0,6,0">
                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PH" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Metrics Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- CPU -->
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}"/>
                    <TextBlock x:Name="TxtCpu" Text="0%" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- RAM -->
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="RAM" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource RamBrush}"/>
                    <TextBlock x:Name="TxtRam" Text="0%" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- GPU -->
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="GPU" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource GpuBrush}"/>
                    <TextBlock x:Name="TxtGpu" Text="0%" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- VRAM -->
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="VRAM" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource VramBrush}"/>
                    <TextBlock x:Name="TxtVram" Text="0%" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- TEMP -->
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="GPU °C" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TempBrush}"/>
                    <TextBlock x:Name="TxtTemp" Text="—" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- DISK IO -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DISCO" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource DiskBrush}"/>
                    <TextBlock x:Name="TxtDisk" Text="0 MB/s" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Close/Hide HUD -->
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                    ToolTip="Ocultar HUD Overlay" Click="BtnClose_Click">
                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            </Button>
        </Grid>
    </Border>
</Window>
