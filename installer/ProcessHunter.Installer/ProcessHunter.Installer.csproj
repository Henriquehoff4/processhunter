<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProcessHunter.Installer</RootNamespace>
    <AssemblyName>ProcessHunter-Installer</AssemblyName>
    <ApplicationIcon>..\..\src\ProcessHunter\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\publish\standalone\ProcessHunter.exe">
      <Link>Resources\ProcessHunter.exe</Link>
    </EmbeddedResource>
    <Resource Include="..\..\src\ProcessHunter\Assets\app.ico" />
  </ItemGroup>
</Project>
