<Window x:Class="ProcessHunter.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador — ProcessHunter" Width="520" Height="410"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#15110E" Foreground="#F2E8DA">
    <Border Background="#1E1915" Margin="16" CornerRadius="16" BorderBrush="#342C25" BorderThickness="1" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="{StaticResource LogoImage}" Width="46" Height="46" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Instalação do ProcessHunter" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock Text="Ultimate System Monitor para Windows 11" Foreground="#B8AA9A" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <!-- Options -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="Pasta de destino" FontSize="11.5" FontWeight="Medium" Foreground="#B8AA9A" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPath" Background="#15110E" Foreground="#F2E8DA" BorderBrush="#342C25" Padding="10,8" FontSize="12" Margin="0,0,0,14"/>

                <CheckBox x:Name="ChkDesktop" Content="Criar atalho na Área de Trabalho (Desktop)" IsChecked="True" Foreground="#F2E8DA" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkStartMenu" Content="Criar atalho no Menu Iniciar" IsChecked="True" Foreground="#F2E8DA" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkLaunch" Content="Iniciar o ProcessHunter após a conclusão" IsChecked="True" Foreground="#F2E8DA" Margin="0,0,0,14"/>

                <ProgressBar x:Name="PbStatus" Height="6" Visibility="Collapsed" IsIndeterminate="True" Foreground="#E2774D"/>
                <TextBlock x:Name="TxtStatus" Text="" Foreground="#B8AA9A" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnCancel" Content="Cancelar" Width="90" Height="34" Margin="0,0,10,0" Background="#28221C" Foreground="#F2E8DA" BorderBrush="#342C25" Click="BtnCancel_Click"/>
                <Button x:Name="BtnInstall" Content="Instalar Agora" Width="140" Height="34" Background="#E2774D" Foreground="#1B120D" FontWeight="SemiBold" BorderThickness="0" Click="BtnInstall_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
