<Application x:Class="ProcessHunter.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry><RectangleGeometry Rect="0,0,256,256"/></DrawingGroup.ClipGeometry>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
                            <GradientStop Color="#2B221B" Offset="0"/>
                            <GradientStop Color="#15110E" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#3D332B" Thickness="3"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="4,4,248,248" RadiusX="58" RadiusY="58"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E2774D">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="58,61,30,150" RadiusX="15" RadiusY="15"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#E2774D" Thickness="24"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="128,115" RadiusX="46" RadiusY="46"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M128,45 L128,57 M128,173 L128,185 M186,115 L198,115">
                    <GeometryDrawing.Pen><Pen Brush="#E2774D" Thickness="13" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F2B65C">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="128,115" RadiusX="16" RadiusY="16"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="hv" Background="#12FFEBD6" CornerRadius="9" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hv" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="bx" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="#978978" Background="#15110E">
                                <Path x:Name="ck" Data="M4,9 L7.5,12.5 L14,5" Stroke="#E2774D" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ck" Property="Visibility" Value="Visible"/><Setter TargetName="bx" Property="BorderBrush" Value="#E2774D"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
